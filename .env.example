# Neon PostgreSQL
DATABASE_URL=postgresql://user:password@host/dbname

# Cloudflare R2
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
R2_BUCKET=clicka
# Full public bucket URL (https recommended). Example: https://pub-xxxx.r2.dev
R2_PUBLIC_URL=https://pub-<hash>.r2.dev

# Resend
RESEND_API_KEY=re_

# Stripe
STRIPE_SECRET_KEY=sk_live_
STRIPE_WEBHOOK_SECRET=whsec_

# OpenRouter (ценоразпис + Google отзиви на публичния сайт)
OPENROUTER_API_KEY=sk-or-
# По подразбиране: perplexity/sonar (уеб). Друг модел с онлайн достъп: OPENROUTER_REVIEWS_MODEL=

# App
NEXT_PUBLIC_APP_URL=https://clicka.bg
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Демо / скриншоти: активирай И двете на preview/staging — без реално плащане, салонът се активира веднага.
# CLICKA_SKIP_CHECKOUT=1
# NEXT_PUBLIC_SKIP_CHECKOUT=1

# Server-only: Static Map (картата на сайта) — не се ползва за Google отзиви
GOOGLE_MAPS_SERVER_KEY=

# SMSAPI (SMS напомняния към клиенти)
SMSAPI_TOKEN=

# Cron auth — в Vercel env + GitHub repo secret (Actions workflow sms-reminders-cron)
CRON_SECRET=
# По избор в GitHub secrets, ако production URL не е https://clicka.bg
# CRON_APP_URL=https://clicka.bg

# Telegram Bot (нотификации за нови резервации + /start onboarding)
TELEGRAM_BOT_TOKEN=
# Произволен таен низ, зададен при регистрация на webhook (1–256 chars)
TELEGRAM_WEBHOOK_SECRET=

# Google Calendar OAuth — ИЗЦЯЛО ПО ИЗБОР, salon owners НЕ го нуждаят.
# Календарът работи без това: ICS feed + iCloud линк (виж admin → Интеграции).
# Само ако платформата иска автоматичен Google OAuth „Свържи с Google“:
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=

CLICKA_OWNER_CHAT_ID=

# Sentry — error tracking (https://sentry.io → New Project → Next.js)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Microsoft Clarity (https://clarity.microsoft.com → New Project → clicka.bg)
NEXT_PUBLIC_CLARITY_ID=
